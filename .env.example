# NC Risk Radar — environment template. Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3000
APP_URL=https://staging.ncwarn.com
# postgres://ncriskradar:PASSWORD@host.docker.internal:5432/ncriskradar
DATABASE_URL=
# redis://redis:6379 (compose-internal redis container)
REDIS_URL=redis://redis:6379/0
# Single shared admin secret for /admin until Auth.js lands (Phase 3). Generate: openssl rand -hex 32
ADMIN_TOKEN=
# Geocoder: census (default, no key) | none
GEOCODER_PROVIDER=census
# Transactional email (SMTP; provider-agnostic). Leave blank to log emails instead of sending.
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NC Risk Radar <no-reply@ncwarn.com>"
CONTACT_TO=contact@ncwarn.com
# Log level: trace|debug|info|warn|error
LOG_LEVEL=info
